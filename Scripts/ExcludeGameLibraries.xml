<?xml version="1.0" encoding="UTF-8"?>
<!--
  Excludes video game libraries from the GC0 capture. These are large and
  purely re-downloadable content (game clients re-fetch them on demand), so
  there is no value in carrying them through the migration store.

  Root-level game folders (swept in by MigDocs.xml's whole-drive document
  heuristic, which scans everything outside %ProgramFiles%):
    C:\GOG Games   - GOG game library (~1.3 GB, ~4,700 files)
    C:\XboxGames   - Xbox / Microsoft Store game installs

  Large game libraries under %ProgramFiles% (already skipped by MigDocs'
  default behavior, but excluded explicitly as insurance in case MigApp.xml /
  MigAppData.xml rules ever reach into them):
    C:\Program Files\Epic Games                  (~177 GB)
    C:\Program Files (x86)\GOG Galaxy\Games      (~165 GB)

  NOT excluded (kept - small and not re-downloadable game content):
    C:\Python313, C:\Portable, C:\tools

  Pattern form "<path>\* [*]" excludes all files in the folder and every
  subfolder recursively. Passed to scanstate via /i:ExcludeGameLibraries.xml.
  unconditionalExclude takes precedence over any include rule.
-->
<migration urlid="http://www.microsoft.com/migration/1.0/migxmlext/exclude_game_libraries">
  <component type="Documents" context="System">
    <displayName>Exclude video game libraries</displayName>
    <role role="Data">
      <rules>
        <unconditionalExclude>
          <objectSet>
            <pattern type="File">C:\GOG Games\* [*]</pattern>
            <pattern type="File">C:\XboxGames\* [*]</pattern>
            <pattern type="File">C:\Program Files\Epic Games\* [*]</pattern>
            <pattern type="File">C:\Program Files (x86)\GOG Galaxy\Games\* [*]</pattern>
          </objectSet>
        </unconditionalExclude>
      </rules>
    </role>
  </component>
</migration>
